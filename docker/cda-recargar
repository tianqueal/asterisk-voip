#!/bin/sh
# Regenera la configuracion y la recarga sin reiniciar Asterisk
# Uso: docker compose exec asterisk cda-recargar
set -eu

/usr/local/bin/cda-config
asterisk -rx 'module reload res_pjsip.so'
asterisk -rx 'dialplan reload'
asterisk -rx 'module reload app_voicemail.so'

echo "Configuracion recargada. Si cambias modules.conf o el transporte: docker compose restart"
